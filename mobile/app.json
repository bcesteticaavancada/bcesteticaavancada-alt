{
  "expo": {
    "name": "BC Estética Avançada",
    "slug": "bc-estetica-mobile",
    "scheme": "bcestetica",
    "version": "0.4.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "android": {
      "package": "br.com.bcesteticaavancada.app",
      "adaptiveIcon": {
        "foregroundImage": "./assets/app-adaptive-icon.png",
        "backgroundColor": "#FCF5F2"
      }
    },
    "ios": {
      "bundleIdentifier": "br.com.bcesteticaavancada.app",
      "supportsTablet": true
    },
    "extra": {
      "prototype": true
    },
    "icon": "./assets/app-icon.png",
    "splash": {
      "image": "./assets/logo-oficial.png",
      "resizeMode": "contain",
      "backgroundColor": "#FFF9F7"
    }
  }
}
