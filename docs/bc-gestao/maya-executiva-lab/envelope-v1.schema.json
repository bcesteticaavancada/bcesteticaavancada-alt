  "$defs": {
    "operacao": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "format": "uuid"
        },
        "intake_id": {
          "type": "string",
          "format": "uuid"
        },
        "tipo": {
          "type": "string",
          "enum": [
            "cadastro",
            "atualizacao_cadastral",
            "atendimento",
            "recebimento",
            "despesa",
            "parcelamento",
            "agendamento",
            "documento",
            "vinculo_documental"
          ]
        },
        "campos": {},
        "campos_faltantes": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 40
          },
          "maxItems": 32
        },
        "evidencias": {
          "type": "array",
