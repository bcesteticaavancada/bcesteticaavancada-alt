            "text/plain",
            "image/png",
            "image/jpeg",
            "image/webp",
            "application/pdf",
            "audio/webm",
            "audio/ogg",
            "audio/mp4",
            "audio/mpeg",
            "audio/wav",
            "audio/aac"
          ]
        },
        "sha256_arquivo": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "motor_utilizado": {
          "type": "string",
          "enum": [
            "parser_texto_local",
            "vosk_wasm_local",
            "transcricao_manual",
            "tesseract_wasm_local",
            "conferencia_manual",
            "pdfjs_nativo_local",
            "pdfjs_tesseract_local"
          ]
        },
        "processado_100_local": {
          "const": true
        },
        "confianca_global": {
          "type": [
            "number",
