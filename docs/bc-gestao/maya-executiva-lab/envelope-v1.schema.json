                "minimum": 1,
                "maximum": 20
              }
            },
            "required": [
              "campo",
              "trecho",
              "pagina"
            ]
          },
          "maxItems": 20
        },
        "dependencias": {
          "type": "array",
          "items": {
            "type": "string",
            "format": "uuid"
          },
          "maxItems": 12
        },
        "estado_revisao": {
          "type": "string",
          "enum": [
            "rascunho",
            "em_conferencia",
            "confirmada",
            "cancelada"
          ]
        },
        "identidade_autorizada": {
          "type": "string",
          "format": "uuid"
        },
        "chave_idempotencia": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "expira_em": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time"
        },
        "resultado": {
          "type": "string",
          "enum": [
            "pendente",
            "registrado_em_homologacao",
            "cancelado"
          ]
        },
        "referencia_oficial": {
          "type": "null"
        },
        "referencia_homologacao": {
          "type": [
            "string",
            "null"
          ],
          "format": "uuid"
        },
        "origem_captura": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "modalidade": {
              "type": "string",
              "enum": [
                "texto",
                "audio",
                "fotografia",
                "pdf_texto_nativo",
                "pdf_digitalizado"
              ]
            },
            "mime_type": {
              "type": "string",
              "enum": [
                "text/plain",
                "image/png",
                "image/jpeg",
                "image/webp",
                "application/pdf",
                "audio/webm",
                "audio/ogg",
                "audio/mp4",
                "audio/mpeg",
                "audio/wav",
                "audio/aac"
              ]
            },
            "sha256_arquivo": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            },
            "motor_utilizado": {
              "type": "string",
              "enum": [
                "parser_texto_local",
                "vosk_wasm_local",
                "transcricao_manual",
                "tesseract_wasm_local",
                "conferencia_manual",
                "pdfjs_nativo_local",
                "pdfjs_tesseract_local"
              ]
            },
            "processado_100_local": {
              "const": true
            },
            "confianca_global": {
